PORT=3000
SERVE_FRONTEND=true
CORS_ORIGIN=*
DB_PROVIDER=sqlite
SQLITE_FILE=./data/arachne.sqlite

# Campanha padrão Projeto Arachne / segurança
MASTER_PASSWORD=troque-esta-senha
SESSION_SECRET=troque-por-uma-chave-longa-e-aleatoria
